[node name="Label9" type="Label" parent="." unique_id=754717999]
offset_left = 1885.0
offset_top = -381.0
offset_right = 2434.0
offset_bottom = -288.0
theme_override_colors/font_color = Color(0, 0, 1, 1)
theme_override_fonts/font = ExtResource("5_fqiu1")
theme_override_font_sizes/font_size = 12
text = "\"WOW, YOU FIGURED IT OUT! Damn, I wanna give you a high five. Good job! 
I know it was easy for some and even annoying, but I mean, this is the product of locking in for 8 hours. 
So I hope you enjoyed it and that you have a good day!
Also, btw, if you go to the flag, you will start again. And there are hidden places you may not have seen 
IF you didn't fall or get detoured in certain places—
which means you're so cool for not falling! BUT you missed out on my very ba— I mean awesome jokes.\""

