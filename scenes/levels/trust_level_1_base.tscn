theme_override_colors/font_color = Color(0.5437599, 0.6902508, 1, 1)
theme_override_fonts/font = ExtResource("5_fqiu1")
theme_override_font_sizes/font_size = 12
text = "\"'Damn, I'm still just starting,' you say? Well, let me tell you, at least the game is only 1 level, and this is the literal point.
 I mean, sure, I said to trust the arrows... but what can I say? Even arrows aren't trustworthy.
Oh, also, you have to get out of here and 'kill' yourself because I was laz—I mean, it was hard to make a restart button.
 And yeah, the right side is magically blocked by thin air. I'm not dumb enough to make it that easy... right?\""

